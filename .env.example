# ------------------------------------------------------------------ #
# FinModel AI environment configuration
# Copy this file to `.env` and fill in values. NEVER commit `.env`.
# ------------------------------------------------------------------ #

# --- OpenAI (required only for the Research Agent and Document Q&A) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_REQUEST_TIMEOUT=60
OPENAI_MAX_RETRIES=3

# --- Data provider ---
# "yfinance" for live data, "local" to force bundled sample data
DATA_PROVIDER=yfinance
REQUEST_TIMEOUT=30
DEFAULT_CURRENCY=USD

# --- Valuation defaults ---
RISK_FREE_RATE=0.04
EQUITY_RISK_PREMIUM=0.055
DEFAULT_TERMINAL_GROWTH=0.025
DEFAULT_TAX_RATE=0.21
FORECAST_YEARS=5

# --- Monte Carlo ---
MONTE_CARLO_SIMULATIONS=10000
MONTE_CARLO_SEED=42

# --- RAG ---
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5

# --- Logging ---
LOG_LEVEL=INFO
